{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "kitchflow-marketing-hub",
      "version": "0.1.0",
      "title": "KitchFlow Marketing Hub"
    },
    "tools": [
      {
        "name": "list_features",
        "title": "List KitchFlow features",
        "description": "List KitchFlow's product features (inventory, food waste, staff scheduling, kitchen tasks, suppliers) with descriptions and page URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_blog_posts",
        "title": "List blog posts",
        "description": "List published KitchFlow blog posts with title, slug, excerpt, category and publish date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "language": {
              "default": "en",
              "description": "Language of the posts to list.",
              "type": "string",
              "enum": [
                "en",
                "fr",
                "ar"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of posts to return.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_blog_post",
        "title": "Get blog post",
        "description": "Read the full text of one published KitchFlow blog post by its slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Post slug, e.g. reduce-coffee-shop-waste"
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
